{
  "name": "@taskmanager/backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "rimraf dist && tsc -b ./tsconfig.json",
    "start": "node dist/index.js",
    "prettyfy": "prettier --log-level warn --cache --write 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "pmd": "prisma migrate dev",
    "pg": "npx prisma generate",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/.eslintcache --ext .ts .",
    "type": "tsc --noEmit --project ./tsconfig.json"
  },
  "devDependencies": {
    "@prisma/config": "^7.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "prisma": "^7.2.0"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^7.2.0",
    "@trpc/server": "^11.7.2",
    "cors": "^2.8.5",
    "express": "^5.2.0",
    "lodash": "^4.17.21",
    "zod": "^3.21.4"
  }
}
